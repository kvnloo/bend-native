ALL_PROXY=http://127.0.0.1:9
BEND_NO_TELEMETRY=1
CUA_DRIVER_RS_TELEMETRY_ENABLED=0
CUA_HOSTLESS=1
HERMES_API_TIMEOUT=600
HERMES_CUA_DRIVER_CMD=${CUA_DRIVER}
HERMES_HOME=${PROFILE_HOME}/.hermes
HERMES_RUNTIME_DIR=${HERMES_PM_RUNTIME}
HF_HUB_OFFLINE=1
HOME=${PROFILE_HOME}
HTTPS_PROXY=http://127.0.0.1:9
HTTP_PROXY=http://127.0.0.1:9
LANG=C.UTF-8
NO_COLOR=1
NO_PROXY=127.0.0.1,localhost
PATH=${HERMES_VENV}/bin:${LEAN}/bin:/usr/local/bin:/usr/bin:/bin
PWD=${RUNS}/aodl-x-failrcpt-off-01/cwd
PYTHONPYCACHEPREFIX=${RUNS}/aodl-x-failrcpt-off-01/pycache
PYTHONUNBUFFERED=1
SHLVL=1
TERM=dumb
TMPDIR=${RUNS}/aodl-x-failrcpt-off-01/tmp
TZ=UTC
UV_CACHE_DIR=${UV_CACHE}
VIRTUAL_ENV=${HERMES_VENV}
XDG_CACHE_HOME=${PROFILE_HOME}/.cache
XDG_CONFIG_HOME=${PROFILE_HOME}/.config
XDG_DATA_HOME=${PROFILE_HOME}/.local/share
XDG_RUNTIME_DIR=${RUNS}/aodl-x-failrcpt-off-01/xdg
XDG_STATE_HOME=${PROFILE_HOME}/.local/state
_=/usr/bin/env
all_proxy=http://127.0.0.1:9
http_proxy=http://127.0.0.1:9
https_proxy=http://127.0.0.1:9
no_proxy=127.0.0.1,localhost
